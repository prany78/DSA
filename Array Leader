class Solution {
    static ArrayList<Integer> leaders(int arr[]) {
        ArrayList<Integer> al=new ArrayList<>();
        int n=arr.length;
        int mr=arr[n-1];
        al.add(mr);
        for(int i=n-2;i>=0;i--)
        {
            if(arr[i]>=mr)
            {
                al.add(arr[i]);
                mr=arr[i];
            }
        }
        Collections.reverse(al);
        return al;
    }
}
